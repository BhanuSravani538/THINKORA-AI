# ==============================================================================
# VerityGraph AI — Backend Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
# Replace with a high-entropy secret string in production (minimum 32 characters)
JWT_SECRET=veritygraph_jwt_super_secure_secret_key_2026_production
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Supabase PostgreSQL Database Integration
# Obtain these from your Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Direct PostgreSQL Connection String for CLI migrations
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
